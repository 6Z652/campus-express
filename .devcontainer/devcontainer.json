{
  "name": "campus-express (Python 3.11 + GitHub Copilot)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {},
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "后端 FastAPI", "onAutoForward": "notify" },
    "8080": { "label": "前端静态页面", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "python -m pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },
  "remoteUser": "vscode"
}
